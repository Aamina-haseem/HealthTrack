@* =====================================================================
   FILE:    Views/DietPlans/EditMeal.cshtml
   PURPOSE: The trainer's "Edit Meal" page for a diet plan (DietPlansController.EditMeal).
            Changes one planned meal; ownership is checked through its plan.
   ===================================================================== *@
@model HealthTrack.ViewModels.DietPlanItemCreateViewModel
@{ ViewData["Title"] = "Edit Planned Meal"; }
@* Two-part card: orange info panel on the left, the form on the right (site.css section 10) *@
<div class="ht-form-page">
    @* Orange info panel: page title, a short intro and tips that state the real validation rules *@
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Diet Plans</span>
        <h1>Edit Meal</h1>
        <p>Change the foods, calories or time of this planned meal.</p>
        @* Which plan / client this form is about *@
        <p class="ht-form-context"><i class="bi bi-journal-text" aria-hidden="true"></i> Diet plan: @ViewBag.PlanTitle</p>
        @* Tips, each with an icon (icons are decorative, so hidden from screen readers) *@
        <ul class="ht-form-tips">
            <li><i class="bi bi-basket" aria-hidden="true"></i><span>List the foods separated by commas.</span></li>
            <li><i class="bi bi-fire" aria-hidden="true"></i><span>Calories can be from 0 to 3,000 for one meal.</span></li>
        </ul>
    </aside>
    @* The form itself *@
    <div class="ht-form-body">
        @* Posts to EditMeal; the form tag helper adds the anti-forgery token automatically. The id in the URL is checked again on the server. *@
        <form asp-action="EditMeal" asp-route-id="@ViewBag.MealId" method="post">
            @* The shared fields (_MealForm.cshtml), also used by the matching Add/Edit page *@
            <partial name="_MealForm" model="Model" />
            @* Buttons: save (arrow button) and cancel (back without saving) *@
            <div class="ht-form-actions">
                <button type="submit" class="btn btn-primary ht-btn-arrow">Save Changes <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Details" asp-route-id="@ViewBag.PlanId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@* Browser-side validation using the same rules as the view model (the server checks again) *@
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
