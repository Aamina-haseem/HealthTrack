@model HealthTrack.ViewModels.DietPlanItemCreateViewModel
@{ ViewData["Title"] = "Edit Planned Meal"; }
<div class="ht-form-page">
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Diet Plans</span>
        <h1>Edit Meal</h1>
        <p>Change the foods, calories or time of this planned meal.</p>
        <p class="ht-form-context"><i class="bi bi-journal-text" aria-hidden="true"></i> Diet plan: @ViewBag.PlanTitle</p>
        <ul class="ht-form-tips">
            <li><i class="bi bi-basket" aria-hidden="true"></i><span>List the foods separated by commas.</span></li>
            <li><i class="bi bi-fire" aria-hidden="true"></i><span>Calories can be from 0 to 3,000 for one meal.</span></li>
        </ul>
    </aside>
    <div class="ht-form-body">
        <form asp-action="EditMeal" asp-route-id="@ViewBag.MealId" method="post">
            <partial name="_MealForm" model="Model" />
            <div class="ht-form-actions">
                <button type="submit" class="btn btn-primary ht-btn-arrow">Save Changes <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Details" asp-route-id="@ViewBag.PlanId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
