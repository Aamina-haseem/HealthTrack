@model HealthTrack.ViewModels.DietPlanCreateViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{ var clients = (IEnumerable<SelectListItem>)ViewBag.Clients; }
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="ClientId" class="form-label">Client</label>
    <select asp-for="ClientId" asp-items="clients" class="form-select"><option value="">-- Select a client --</option></select>
    <span asp-validation-for="ClientId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="DailyCalorieTarget" class="form-label"></label><input asp-for="DailyCalorieTarget" class="form-control" /><span asp-validation-for="DailyCalorieTarget" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control" /><span asp-validation-for="StartDate" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" class="form-control" /><span asp-validation-for="EndDate" class="text-danger"></span></div>
