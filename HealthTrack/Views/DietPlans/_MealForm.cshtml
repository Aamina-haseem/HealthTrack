@model HealthTrack.ViewModels.DietPlanItemCreateViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row">
    <div class="col-sm-6 mb-3"><label asp-for="MealType" class="form-label"></label>
        <div class="ht-input"><i class="bi bi-egg-fried" aria-hidden="true"></i>
            <select asp-for="MealType" asp-items="Html.GetEnumSelectList<HealthTrack.Models.MealType>()" class="form-select"></select></div>
        <span asp-validation-for="MealType" class="text-danger"></span></div>
    <div class="col-sm-6 mb-3"><label asp-for="MealTime" class="form-label"></label>
        <div class="ht-input"><i class="bi bi-clock" aria-hidden="true"></i><input asp-for="MealTime" type="time" class="form-control" /></div>
        <span asp-validation-for="MealTime" class="text-danger"></span></div>
</div>
<div class="mb-3"><label asp-for="FoodItems" class="form-label"></label>
    <div class="ht-input"><i class="bi bi-basket" aria-hidden="true"></i><input asp-for="FoodItems" class="form-control" placeholder="e.g. Oats, banana, Greek yoghurt" /></div>
    <span asp-validation-for="FoodItems" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Calories" class="form-label"></label>
    <div class="ht-input"><i class="bi bi-fire" aria-hidden="true"></i><input asp-for="Calories" class="form-control" /></div>
    <span asp-validation-for="Calories" class="text-danger"></span></div>
