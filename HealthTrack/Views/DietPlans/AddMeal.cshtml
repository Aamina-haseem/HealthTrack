@model HealthTrack.ViewModels.DietPlanItemCreateViewModel
@{ ViewData["Title"] = "Add Planned Meal"; }
<h1>Add Meal</h1><p class="text-muted">Diet plan: @ViewBag.PlanTitle</p>
<form asp-action="AddMeal" asp-route-id="@ViewBag.PlanId" method="post">
    <partial name="_MealForm" model="Model" />
    <button type="submit" class="btn btn-primary">Add Meal</button>
    <a asp-action="Details" asp-route-id="@ViewBag.PlanId" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
