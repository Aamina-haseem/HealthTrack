@* =====================================================================
   FILE:    Views/DietPlans/Edit.cshtml
   PURPOSE: The trainer's "Edit Diet Plan" page (DietPlansController.Edit).
            The plan id in the URL is checked to belong to the signed-in trainer.
   ===================================================================== *@
@model HealthTrack.ViewModels.DietPlanCreateViewModel
@{ ViewData["Title"] = "Edit Diet Plan"; }
@* Two-part card: orange info panel on the left, the form on the right (site.css section 10) *@
<div class="ht-form-page">
    @* Orange info panel: page title, a short intro and tips that state the real validation rules *@
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Diet Plans</span>
        <h1>Edit Diet Plan</h1>
        <p>Update the plan details. Your client sees the changes as soon as you save.</p>
        @* Tips, each with an icon (icons are decorative, so hidden from screen readers) *@
        <ul class="ht-form-tips">
            <li><i class="bi bi-egg-fried" aria-hidden="true"></i><span>Planned meals are kept. Edit them from the plan page.</span></li>
            <li><i class="bi bi-fire" aria-hidden="true"></i><span>The daily target must be between 800 and 6,000 kcal.</span></li>
            <li><i class="bi bi-calendar-range" aria-hidden="true"></i><span>The end date is optional, but it cannot be before the start date.</span></li>
        </ul>
    </aside>
    @* The form itself *@
    <div class="ht-form-body">
        @* Posts to Edit; the form tag helper adds the anti-forgery token automatically. The id in the URL is checked again on the server. *@
        <form asp-action="Edit" asp-route-id="@ViewBag.PlanId" method="post">
            @* The shared fields (_PlanForm.cshtml), also used by the matching Add/Edit page *@
            <partial name="_PlanForm" model="Model" />
            @* Buttons: save (arrow button) and cancel (back without saving) *@
            <div class="ht-form-actions">
                <button class="btn btn-primary ht-btn-arrow" type="submit">Save Changes <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Details" asp-route-id="@ViewBag.PlanId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@* Browser-side validation using the same rules as the view model (the server checks again) *@
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
