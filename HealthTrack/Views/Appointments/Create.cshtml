@model HealthTrack.ViewModels.AppointmentCreateViewModel
@using HealthTrack.ViewModels
@{
    ViewData["Title"] = "Book Appointment";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <span class="ht-eyebrow">Appointments</span>
        <h1 class="mb-1">Book an Appointment</h1>
        <p class="text-muted">Choose a trainer or health professional and a time. They will approve or suggest another time.</p>

        <div class="card"><div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="TrainerId" class="form-label"></label>
                    <select asp-for="TrainerId" asp-items="Model.Trainers" class="form-select">
                        <option value="">-- Select a trainer --</option>
                    </select>
                    <span asp-validation-for="TrainerId" class="text-danger small"></span>
                    @if (!Model.Trainers.Any())
                    {
                        <div class="form-text text-danger">No trainers are available at the moment.</div>
                    }
                </div>

                <div class="mb-3">
                    <label asp-for="AppointmentDate" class="form-label"></label>
                    <input asp-for="AppointmentDate" type="datetime-local" class="form-control"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    <div class="form-text">
                        Between @AppointmentRules.OpeningHour.ToString("00"):00 and @AppointmentRules.ClosingHour.ToString("00"):00,
                        up to @AppointmentRules.MaxDaysAhead days ahead.
                    </div>
                    <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Reason" class="form-label"></label>
                    <textarea asp-for="Reason" class="form-control" rows="3"
                              placeholder="e.g. Monthly progress review, knee pain during squats, new diet plan..."></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-calendar-plus"></i> Request Appointment</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                </div>
            </form>
        </div></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
