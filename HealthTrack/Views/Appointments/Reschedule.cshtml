@* =====================================================================
   FILE:    Views/Appointments/Reschedule.cshtml
   PURPOSE: The trainer's "Update Appointment" page (AppointmentsController.Reschedule).
            Set the time and add private notes (stored encrypted). Saving approves it.
   ===================================================================== *@
@model HealthTrack.ViewModels.AppointmentRescheduleViewModel
@using HealthTrack.ViewModels
@{
    ViewData["Title"] = "Update Appointment";
}

@* Two-part card: orange info panel on the left, the form on the right (site.css section 10) *@
<div class="ht-form-page">
    @* Orange info panel: page title, who the appointment is with, and the rules *@
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Trainer</span>
        <h1>Update Appointment</h1>
        <p>Set the time for this consultation and add your private notes.</p>
        @* Which plan / client this form is about *@
        <p class="ht-form-context"><i class="bi bi-person" aria-hidden="true"></i> With @Model.ClientName &middot; @Model.Reason</p>
        @* Tips, each with an icon (icons are decorative, so hidden from screen readers) *@
        <ul class="ht-form-tips">
            <li><i class="bi bi-clock" aria-hidden="true"></i><span>Appointments start between @AppointmentRules.OpeningHour.ToString("00"):00 and @AppointmentRules.ClosingHour.ToString("00"):00.</span></li>
            <li><i class="bi bi-check2-circle" aria-hidden="true"></i><span>Saving confirms (approves) the appointment and notifies the client.</span></li>
            <li><i class="bi bi-lock" aria-hidden="true"></i><span>Your notes are private to you and stored encrypted.</span></li>
        </ul>
    </aside>

    @* The form itself *@
    <div class="ht-form-body">
        @* Posts to Reschedule; the form tag helper adds the anti-forgery token automatically. The id in the URL is checked again on the server. *@
        <form asp-action="Reschedule" asp-route-id="@Model.Id" method="post">
            @* Errors that are not about one field, e.g. "could not be saved" *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            @* The appointment id travels with the form; the server checks it again *@
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                @* Date and time (the min attribute stops past times in the browser) *@
                <label asp-for="AppointmentDate" class="form-label"></label>
                <div class="ht-input">
                    <i class="bi bi-calendar-event" aria-hidden="true"></i>
                    <input asp-for="AppointmentDate" type="datetime-local" class="form-control" />
                </div>
                <div class="form-text">
                    Between @AppointmentRules.OpeningHour.ToString("00"):00 and @AppointmentRules.ClosingHour.ToString("00"):00.
                    Saving confirms (approves) the appointment and notifies the client.
                </div>
                <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                @* Private trainer notes, encrypted in the database *@
                <label asp-for="TrainerNotes" class="form-label"></label>
                <div class="ht-input">
                    <i class="bi bi-journal-text" aria-hidden="true"></i>
                    <textarea asp-for="TrainerNotes" class="form-control" rows="4"
                              placeholder="Private notes for this consultation (stored encrypted)"></textarea>
                </div>
                <span asp-validation-for="TrainerNotes" class="text-danger small"></span>
            </div>

            @* Buttons: save (arrow button) and cancel (back without saving) *@
            <div class="ht-form-actions">
                <button type="submit" class="btn btn-primary ht-btn-arrow">Save Changes <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@* Browser-side validation using the same rules as the view model (the server checks again) *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
