@* =====================================================================
   FILE:    Views/_ViewImports.cshtml
   PURPOSE: Settings shared by every view in the Views folder: the namespaces
            every view can use without typing them, and the tag helpers
            (asp-for, asp-action, asp-controller, ...) that turn into real HTML.
   ===================================================================== *@
@using HealthTrack
@using HealthTrack.Models
@* Enables all ASP.NET Core MVC tag helpers in every view *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
