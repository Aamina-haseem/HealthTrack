@* =====================================================================
   FILE:    Views/Shared/_LoginPartial.cshtml
   PURPOSE: The account links in the top navigation for visitors' pages: the
            user's name and a Logout button when signed in, or Register / Login
            when not. Logout is a POST form, so it carries an anti-forgery token.
   ===================================================================== *@
@using Microsoft.AspNetCore.Identity
@using HealthTrack.Models
@* Identity services injected into the view *@
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @* Signed in: show the user's name and a Logout button *@
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        <li class="nav-item">
            @* Link to the Identity "Manage account" page *@
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage account">
                <i class="bi bi-person-circle"></i> @(currentUser?.FullName ?? User.Identity?.Name)
            </a>
        </li>
        <li class="nav-item">
            @* Logout must be a POST (with an anti-forgery token), then go back to the home page *@
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="nav-link btn btn-link text-white border-0">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </li>
    }
    else
    {
        @* Not signed in: links to Register and Login *@
        <li class="nav-item">
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Register"><i class="bi bi-person-plus"></i> Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Login</a>
        </li>
    }
</ul>