@using HealthTrack.Models
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthTrack</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Theme fonts: Montserrat for headings, Inter for body text -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700&display=swap" />
    <!-- Bootstrap Icons (used for menu and dashboard icons) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HealthTrack.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl ht-navbar shadow-sm mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill"></i> HealthTrack
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @* Client navigation *@
                        @if (User.IsInRole(AppRoles.Client))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Client" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Client" asp-action="WorkoutPlans"><i class="bi bi-activity"></i> Workouts</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Client" asp-action="DietPlans"><i class="bi bi-egg-fried"></i> Diet</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Logs" asp-action="Index"><i class="bi bi-journal-plus"></i> Log Activity</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Progress" asp-action="Index"><i class="bi bi-graph-up-arrow"></i> Progress</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-check"></i> Appointments</a></li>
                        }

                        @* Trainer navigation *@
                        @if (User.IsInRole(AppRoles.Trainer))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Trainer" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Trainer" asp-action="Clients"><i class="bi bi-people"></i> My Clients</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="WorkoutPlans" asp-action="Index"><i class="bi bi-activity"></i> Workout Plans</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="DietPlans" asp-action="Index"><i class="bi bi-egg-fried"></i> Diet Plans</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-check"></i> Appointments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Progress" asp-action="Reports"><i class="bi bi-bar-chart"></i> Reports</a></li>
                        }

                        @* Administrator navigation *@
                        @if (User.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users"><i class="bi bi-person-gear"></i> Users</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Assignments"><i class="bi bi-diagram-3"></i> Trainer Assignments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Progress" asp-action="Reports"><i class="bi bi-bar-chart"></i> Reports</a></li>
                        }

                        @* Navigation before sign-in *@
                        @if (!(User.Identity?.IsAuthenticated ?? false))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                        }
                    </ul>

                    @* Notifications bell; unread count can be added later. *@
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <ul class="navbar-nav me-2">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Notifications" asp-action="Index" title="Notifications">
                                    <i class="bi bi-bell-fill"></i>
                                </a>
                            </li>
                        </ul>
                    }

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @* Success / error messages set by controllers with TempData *@
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - HealthTrack - Personal Health &amp; Fitness Management -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js for progress and analytics charts (Task 7) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>