@* =====================================================================
   FILE:    Views/Shared/Components/NotificationBell/Default.cshtml
   PURPOSE: The HTML of the bell in the top bar, drawn by
            NotificationBellViewComponent. Shows a red badge with the number of
            unread notifications (9+ when there are more than 9).
   ===================================================================== *@
@model int
@* Navbar bell. Model = number of unread notifications for the signed-in user. *@
<a class="nav-link position-relative" asp-area="" asp-controller="Notifications" asp-action="Index"
   title="Notifications" aria-label="Notifications, @Model unread">
    <i class="bi bi-bell-fill"></i>
    @* Badge only when there is something unread *@
    @if (Model > 0)
    {
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
            @(Model > 9 ? "9+" : Model.ToString())
            @* Read out by screen readers, hidden on screen *@
            <span class="visually-hidden">unread notifications</span>
        </span>
    }
</a>
