@model HealthTrack.ViewModels.WorkoutPlanItemCreateViewModel

@{
    ViewData["Title"] = "Add Exercise";

    // The controller has already checked that this trainer owns the plan.
    var planId = (int)ViewBag.PlanId;
    var planTitle = (string)ViewBag.PlanTitle;
}

<div class="ht-form-page">
    @* Orange info panel: page title, the plan this exercise belongs to, and tips *@
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Workout Plans</span>
        <h1>Add Exercise</h1>
        <p>Add one exercise to a day of the plan.</p>
        <p class="ht-form-context"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i> Workout plan: @planTitle</p>
        <ul class="ht-form-tips">
            <li><i class="bi bi-repeat" aria-hidden="true"></i><span>Counted exercise: enter sets (up to 20) and reps (up to 100).</span></li>
            <li><i class="bi bi-stopwatch" aria-hidden="true"></i><span>Timed exercise: enter a duration of up to 300 minutes.</span></li>
            <li><i class="bi bi-chat-left-text" aria-hidden="true"></i><span>Use notes for form cues, rest times or equipment.</span></li>
        </ul>
    </aside>

    <div class="ht-form-body">
        @* Keep the verified plan ID in the URL when submitting the form. *@
        <form asp-controller="WorkoutPlans"
              asp-action="AddExercise"
              asp-route-id="@planId"
              method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-7 mb-3">
                    <label asp-for="ExerciseName" class="form-label"></label>
                    <div class="ht-input">
                        <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                        <input asp-for="ExerciseName" class="form-control" placeholder="e.g. Squats" />
                    </div>
                    <span asp-validation-for="ExerciseName" class="text-danger"></span>
                </div>

                <div class="col-md-5 mb-3">
                    <label asp-for="DayOfWeek" class="form-label"></label>
                    <div class="ht-input">
                        <i class="bi bi-calendar-week" aria-hidden="true"></i>
                        <select asp-for="DayOfWeek"
                                asp-items="Html.GetEnumSelectList<System.DayOfWeek>()"
                                class="form-select">
                        </select>
                    </div>
                    <span asp-validation-for="DayOfWeek" class="text-danger"></span>
                </div>
            </div>

            <fieldset class="ht-form-group">
                <legend>Sets and reps, or a duration</legend>
                <p class="form-text mt-0 mb-3">
                    Enter sets and reps for a counted exercise, or a duration for a timed exercise.
                </p>

                <div class="row">
                    <div class="col-sm-4 mb-3">
                        <label asp-for="Sets" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-layers" aria-hidden="true"></i>
                            <input asp-for="Sets" class="form-control" min="0" max="20" />
                        </div>
                        <span asp-validation-for="Sets" class="text-danger"></span>
                    </div>

                    <div class="col-sm-4 mb-3">
                        <label asp-for="Reps" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-repeat" aria-hidden="true"></i>
                            <input asp-for="Reps" class="form-control" min="0" max="100" />
                        </div>
                        <span asp-validation-for="Reps" class="text-danger"></span>
                    </div>

                    <div class="col-sm-4 mb-3">
                        <label asp-for="DurationMinutes" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-stopwatch" aria-hidden="true"></i>
                            <input asp-for="DurationMinutes" class="form-control" min="0" max="300" />
                        </div>
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <div class="ht-input">
                    <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="ht-form-actions">
                <button type="submit" class="btn btn-primary ht-btn-arrow">Save Exercise <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}