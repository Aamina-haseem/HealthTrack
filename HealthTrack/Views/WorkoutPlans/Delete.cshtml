@model HealthTrack.Models.WorkoutPlan
@{
    ViewData["Title"] = "Delete Workout Plan";
}
<h1>Delete Workout Plan</h1>
<p>Delete <strong>@Model.Title</strong> and all its exercises? Previous workout logs will remain.</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button class="btn btn-danger" type="submit">Delete Plan</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
</form>
