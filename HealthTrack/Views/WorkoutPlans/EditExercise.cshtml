@* =====================================================================
   FILE:    Views/WorkoutPlans/EditExercise.cshtml
   PURPOSE: The trainer's "Edit Exercise" page (WorkoutPlansController.EditExercise).
            Same fields as Add Exercise; ownership is checked through the exercise's plan.
   ===================================================================== *@
@model HealthTrack.ViewModels.WorkoutPlanItemCreateViewModel

@{
    ViewData["Title"] = "Edit Exercise";
}

@* Two-part card: orange info panel on the left, the form on the right (site.css section 10) *@
<div class="ht-form-page">
    @* Orange info panel: page title, the plan this exercise belongs to, and tips *@
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Workout Plans</span>
        <h1>Edit Exercise</h1>
        <p>Change the day, the amount or the notes for this exercise.</p>
        @* Which plan / client this form is about *@
        <p class="ht-form-context"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i> Workout plan: @ViewBag.PlanTitle</p>
        @* Tips, each with an icon (icons are decorative, so hidden from screen readers) *@
        <ul class="ht-form-tips">
            <li><i class="bi bi-repeat" aria-hidden="true"></i><span>Counted exercise: enter sets (up to 20) and reps (up to 100).</span></li>
            <li><i class="bi bi-stopwatch" aria-hidden="true"></i><span>Timed exercise: enter a duration of up to 300 minutes.</span></li>
        </ul>
    </aside>

    @* The form itself *@
    <div class="ht-form-body">
        @* Posts to EditExercise; the form tag helper adds the anti-forgery token automatically. The id in the URL is checked again on the server. *@
        <form asp-action="EditExercise" asp-route-id="@ViewBag.ExerciseId" method="post">
            @Html.AntiForgeryToken()

            @* Errors that are not about one field, e.g. "could not be saved" *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-7 mb-3">
                    @* Exercise name *@
                    <label asp-for="ExerciseName" class="form-label"></label>
                    <div class="ht-input">
                        <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                        <input asp-for="ExerciseName" class="form-control" />
                    </div>
                    <span asp-validation-for="ExerciseName" class="text-danger"></span>
                </div>

                <div class="col-md-5 mb-3">
                    @* Day of the week drop-down built from the DayOfWeek enum *@
                    <label asp-for="DayOfWeek" class="form-label"></label>
                    <div class="ht-input">
                        <i class="bi bi-calendar-week" aria-hidden="true"></i>
                        <select asp-for="DayOfWeek"
                                asp-items="Html.GetEnumSelectList<DayOfWeek>()"
                                class="form-select"></select>
                    </div>
                    <span asp-validation-for="DayOfWeek" class="text-danger"></span>
                </div>
            </div>

            @* A group of related fields with a small heading (legend) *@
            <fieldset class="ht-form-group">
                <legend>Sets and reps, or a duration</legend>

                <div class="row">
                    <div class="col-sm-4 mb-3">
                        @* Sets (0 to 20) *@
                        <label asp-for="Sets" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-layers" aria-hidden="true"></i>
                            <input asp-for="Sets" class="form-control" />
                        </div>
                        <span asp-validation-for="Sets" class="text-danger"></span>
                    </div>

                    <div class="col-sm-4 mb-3">
                        @* Reps per set (0 to 100) *@
                        <label asp-for="Reps" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-repeat" aria-hidden="true"></i>
                            <input asp-for="Reps" class="form-control" />
                        </div>
                        <span asp-validation-for="Reps" class="text-danger"></span>
                    </div>

                    <div class="col-sm-4 mb-3">
                        @* Duration in minutes (for timed exercises) *@
                        <label asp-for="DurationMinutes" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-stopwatch" aria-hidden="true"></i>
                            <input asp-for="DurationMinutes" class="form-control" />
                        </div>
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <div class="mb-3">
                @* Optional notes *@
                <label asp-for="Notes" class="form-label"></label>
                <div class="ht-input">
                    <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            @* Buttons: save (arrow button) and cancel (back without saving) *@
            <div class="ht-form-actions">
                <button type="submit" class="btn btn-primary ht-btn-arrow">Save Changes <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Details"
                   asp-route-id="@ViewBag.PlanId"
                   class="btn btn-outline-secondary">Back to Plan</a>
            </div>
        </form>
    </div>
</div>

@* Browser-side validation using the same rules as the view model (the server checks again) *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
