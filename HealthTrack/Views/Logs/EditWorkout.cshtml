@* =====================================================================
   FILE:    Views/Logs/EditWorkout.cshtml
   PURPOSE: The client's "Edit Workout" page (LogsController.EditWorkout).
            Same fields as Log Workout; the id in the URL is checked against the signed-in client.
   ===================================================================== *@
@model HealthTrack.ViewModels.WorkoutLogCreateViewModel
@{ ViewData["Title"] = "Edit Workout"; }
@* Two-part card: orange info panel on the left, the form on the right (site.css section 10) *@
<div class="ht-form-page">
    @* Orange info panel: page title, a short intro and tips that state the real validation rules *@
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Activity Log</span>
        <h1>Edit Workout</h1>
        <p>Correct the details of a workout you logged. Your charts update when you save.</p>
        @* Tips, each with an icon (icons are decorative, so hidden from screen readers) *@
        <ul class="ht-form-tips">
            <li><i class="bi bi-stopwatch" aria-hidden="true"></i><span>Duration is 1 to 600 minutes. Calories burned are 0 to 5,000.</span></li>
            <li><i class="bi bi-calendar-x" aria-hidden="true"></i><span>The date cannot be in the future.</span></li>
        </ul>
    </aside>
    @* The form itself *@
    <div class="ht-form-body">
        @* Posts to EditWorkout; the form tag helper adds the anti-forgery token automatically. The id in the URL is checked again on the server. *@
        <form asp-action="EditWorkout" asp-route-id="@ViewBag.LogId" method="post">
            @* The shared fields (_WorkoutForm.cshtml), also used by the matching Add/Edit page *@
            <partial name="_WorkoutForm" model="Model" />
            @* Buttons: save (arrow button) and cancel (back without saving) *@
            <div class="ht-form-actions">
                <button class="btn btn-primary ht-btn-arrow" type="submit">Save Changes <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@* Browser-side validation using the same rules as the view model (the server checks again) *@
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
