@model HealthTrack.ViewModels.HealthMeasurementCreateViewModel
@{ ViewData["Title"] = "Record Measurement"; }
<div class="ht-form-page">
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Activity Log</span>
        <h1>Record Measurement</h1>
        <p>BMI is calculated from your weight and height after saving.</p>
        <ul class="ht-form-tips">
            <li><i class="bi bi-speedometer2" aria-hidden="true"></i><span>Weigh yourself at the same time of day for a fair trend.</span></li>
            <li><i class="bi bi-rulers" aria-hidden="true"></i><span>Weight is 20 to 300 kg. Height is 50 to 250 cm.</span></li>
            <li><i class="bi bi-heart-pulse" aria-hidden="true"></i><span>Resting heart rate is optional (30 to 220 bpm).</span></li>
        </ul>
    </aside>
    <div class="ht-form-body">
        <form asp-action="AddMeasurement" method="post">
            <partial name="_MeasurementForm" model="Model" />
            <div class="ht-form-actions">
                <button class="btn btn-primary ht-btn-arrow" type="submit">Save Measurement <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
