@* =====================================================================
   FILE:    Views/Logs/EditMeasurement.cshtml
   PURPOSE: The client's "Edit Measurement" page (LogsController.EditMeasurement).
            Same fields as Record Measurement; BMI is recalculated when saved.
   ===================================================================== *@
@model HealthTrack.ViewModels.HealthMeasurementCreateViewModel
@{ ViewData["Title"] = "Edit Measurement"; }
@* Two-part card: orange info panel on the left, the form on the right (site.css section 10) *@
<div class="ht-form-page">
    @* Orange info panel: page title, a short intro and tips that state the real validation rules *@
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Activity Log</span>
        <h1>Edit Measurement</h1>
        <p>BMI is calculated again from the new weight and height when you save.</p>
        @* Tips, each with an icon (icons are decorative, so hidden from screen readers) *@
        <ul class="ht-form-tips">
            <li><i class="bi bi-rulers" aria-hidden="true"></i><span>Weight is 20 to 300 kg. Height is 50 to 250 cm.</span></li>
            <li><i class="bi bi-heart-pulse" aria-hidden="true"></i><span>Resting heart rate is optional (30 to 220 bpm).</span></li>
        </ul>
    </aside>
    @* The form itself *@
    <div class="ht-form-body">
        @* Posts to EditMeasurement; the form tag helper adds the anti-forgery token automatically. The id in the URL is checked again on the server. *@
        <form asp-action="EditMeasurement" asp-route-id="@ViewBag.LogId" method="post">
            @* The shared fields (_MeasurementForm.cshtml), also used by the matching Add/Edit page *@
            <partial name="_MeasurementForm" model="Model" />
            @* Buttons: save (arrow button) and cancel (back without saving) *@
            <div class="ht-form-actions">
                <button class="btn btn-primary ht-btn-arrow" type="submit">Save Changes <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@* Browser-side validation using the same rules as the view model (the server checks again) *@
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
