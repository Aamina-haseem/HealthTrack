@model HealthTrack.ViewModels.MealLogCreateViewModel
@{ ViewData["Title"] = "Edit Meal Log"; }
<div class="ht-form-page">
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Activity Log</span>
        <h1>Edit Meal Log</h1>
        <p>Correct the details of a meal you logged. Your charts update when you save.</p>
        <ul class="ht-form-tips">
            <li><i class="bi bi-fire" aria-hidden="true"></i><span>Calories can be from 0 to 5,000.</span></li>
            <li><i class="bi bi-calendar-x" aria-hidden="true"></i><span>The date cannot be in the future.</span></li>
        </ul>
    </aside>
    <div class="ht-form-body">
        <form asp-action="EditMeal" asp-route-id="@ViewBag.LogId" method="post">
            <partial name="_MealForm" model="Model" />
            <div class="ht-form-actions">
                <button class="btn btn-primary ht-btn-arrow" type="submit">Save Changes <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
