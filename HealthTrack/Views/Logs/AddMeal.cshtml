@* =====================================================================
   FILE:    Views/Logs/AddMeal.cshtml
   PURPOSE: The client's "Log Meal" page (LogsController.AddMeal).
            Orange info panel with tips beside the shared meal fields.
   ===================================================================== *@
@model HealthTrack.ViewModels.MealLogCreateViewModel
@{ ViewData["Title"] = "Log Meal"; }
@* Two-part card: orange info panel on the left, the form on the right (site.css section 10) *@
<div class="ht-form-page">
    @* Orange info panel: page title, a short intro and tips that state the real validation rules *@
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Activity Log</span>
        <h1>Log Meal</h1>
        <p>Record what you ate. Calories eaten are compared with calories burned on your dashboard.</p>
        @* Tips, each with an icon (icons are decorative, so hidden from screen readers) *@
        <ul class="ht-form-tips">
            <li><i class="bi bi-basket" aria-hidden="true"></i><span>List the foods separated by commas.</span></li>
            <li><i class="bi bi-fire" aria-hidden="true"></i><span>Calories can be from 0 to 5,000.</span></li>
            <li><i class="bi bi-calendar-x" aria-hidden="true"></i><span>The date cannot be in the future.</span></li>
        </ul>
    </aside>
    @* The form itself *@
    <div class="ht-form-body">
        @* Posts to AddMeal; the form tag helper adds the anti-forgery token automatically. *@
        <form asp-action="AddMeal" method="post">
            @* The shared fields (_MealForm.cshtml), also used by the matching Add/Edit page *@
            <partial name="_MealForm" model="Model" />
            @* Buttons: save (arrow button) and cancel (back without saving) *@
            <div class="ht-form-actions">
                <button class="btn btn-primary ht-btn-arrow" type="submit">Save Meal <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@* Browser-side validation using the same rules as the view model (the server checks again) *@
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
