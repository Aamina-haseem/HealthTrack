@* =====================================================================
   FILE:    Views/Logs/_MealForm.cshtml
   PURPOSE: The meal fields, shared by "Log Meal" and "Edit Meal Log" so both
            forms always match. Each asp-for links a box to a property of
            MealLogCreateViewModel; asp-validation-for shows its error message.
   ===================================================================== *@
@model HealthTrack.ViewModels.MealLogCreateViewModel
@* Errors that are not about one field *@
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
@* Row 1: date and meal type *@
<div class="row">
    <div class="col-sm-6 mb-3"><label asp-for="Date" class="form-label"></label>
        <div class="ht-input"><i class="bi bi-calendar-event" aria-hidden="true"></i><input asp-for="Date" class="form-control" /></div>
        <span asp-validation-for="Date" class="text-danger"></span></div>
    @* GetEnumSelectList turns the MealType enum into drop-down options *@
    <div class="col-sm-6 mb-3"><label asp-for="MealType" class="form-label"></label>
        <div class="ht-input"><i class="bi bi-egg-fried" aria-hidden="true"></i><select asp-for="MealType" asp-items="Html.GetEnumSelectList<HealthTrack.Models.MealType>()" class="form-select"></select></div>
        <span asp-validation-for="MealType" class="text-danger"></span></div>
</div>
@* What was eaten *@
<div class="mb-3"><label asp-for="FoodItems" class="form-label"></label>
    <div class="ht-input"><i class="bi bi-basket" aria-hidden="true"></i><input asp-for="FoodItems" class="form-control" placeholder="e.g. Rice, chicken curry, salad" /></div>
    <span asp-validation-for="FoodItems" class="text-danger"></span></div>
@* Calories in the meal *@
<div class="mb-3"><label asp-for="Calories" class="form-label"></label>
    <div class="ht-input"><i class="bi bi-fire" aria-hidden="true"></i><input asp-for="Calories" class="form-control" /></div>
    <span asp-validation-for="Calories" class="text-danger"></span></div>
