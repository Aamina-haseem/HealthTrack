@model HealthTrack.ViewModels.WorkoutLogCreateViewModel
@{ ViewData["Title"] = "Log Workout"; }
<h1>Log Workout</h1>
<form asp-action="AddWorkout" method="post">
    <partial name="_WorkoutForm" model="Model" />
    <button class="btn btn-primary" type="submit">Save Workout</button><a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
