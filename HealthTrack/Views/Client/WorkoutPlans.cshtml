@* =====================================================================
   FILE:    Views/Client/WorkoutPlans.cshtml
   PURPOSE: The client's "Workouts" page (ClientController.WorkoutPlans): one card
            per workout plan their trainer made, with an Active / Ended badge and
            a button to open the plan.
   ===================================================================== *@
@model IReadOnlyList<HealthTrack.Models.WorkoutPlan>
@{ ViewData["Title"] = "My Workout Plans"; }

@* ClientController.WorkoutPlans only loads plans that belong to the signed-in client. *@
<div class="mb-4">
    <span class="ht-eyebrow">My plans</span>
    <h1 class="mb-1">Workout Plans</h1>
    <p class="text-muted mb-0">Plans your trainer has made for you. Open one to see the exercises for each day.</p>
</div>

@if (Model.Count == 0)
{
    @* Empty state *@
    <div class="card"><div class="card-body">
        <div class="ht-empty"><i class="bi bi-activity" aria-hidden="true"></i>No workout plan yet. Your trainer will assign one.</div>
    </div></div>
}
else
{
    @* One card per plan in a responsive grid *@
    <div class="row g-4">
        @foreach (var plan in Model)
        {
            // A plan has ended once its end date has passed.
            var ended = plan.EndDate is not null && plan.EndDate.Value.Date < DateTime.Today;
            <div class="col-md-6 col-xl-4">
                <article class="card h-100"><div class="card-body d-flex flex-column">
                    @* Icon and the Active / Ended badge *@
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <span class="ht-stat-icon" aria-hidden="true"><i class="bi bi-activity"></i></span>
                        <span class="badge rounded-pill @(ended ? "text-bg-secondary" : "text-bg-success")">@(ended ? "Ended" : "Active")</span>
                    </div>
                    <h2 class="h5">@plan.Title</h2>
                    <p class="text-muted small mb-2">@plan.Difficulty · @(plan.Goal ?? "No goal set")</p>
                    @* Dates; no end date means the plan is ongoing *@
                    <p class="small mb-3">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        @plan.StartDate.ToString("dd MMM yyyy") – @(plan.EndDate?.ToString("dd MMM yyyy") ?? "ongoing")
                    </p>
                    @* Opens ClientController.WorkoutPlan, which checks the plan is theirs *@
                    <a asp-action="WorkoutPlan" asp-route-id="@plan.Id" class="btn btn-sm btn-primary mt-auto align-self-start">Open plan</a>
                </div></article>
            </div>
        }
    </div>
}
<a asp-action="Index" class="btn btn-secondary mt-4">Dashboard</a>
