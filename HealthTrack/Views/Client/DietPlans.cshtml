@* =====================================================================
   FILE:    Views/Client/DietPlans.cshtml
   PURPOSE: The client's "Diet" page (ClientController.DietPlans): one card per
            diet plan from their trainer, showing the daily calorie target, an
            Active / Ended badge and a button to open the plan.
   ===================================================================== *@
@model IReadOnlyList<HealthTrack.Models.DietPlan>
@{ ViewData["Title"] = "My Diet Plans"; }

@* ClientController.DietPlans only loads plans that belong to the signed-in client. *@
<div class="mb-4">
    <span class="ht-eyebrow">My plans</span>
    <h1 class="mb-1">Diet Plans</h1>
    <p class="text-muted mb-0">Meal plans and calorie targets from your trainer. Open one to see each meal.</p>
</div>

@if (Model.Count == 0)
{
    @* Empty state *@
    <div class="card"><div class="card-body">
        <div class="ht-empty"><i class="bi bi-egg-fried" aria-hidden="true"></i>No diet plan yet. Your trainer will assign one.</div>
    </div></div>
}
else
{
    @* One card per plan in a responsive grid *@
    <div class="row g-4">
        @foreach (var plan in Model)
        {
            // A plan has ended once its end date has passed.
            var ended = plan.EndDate is not null && plan.EndDate.Value.Date < DateTime.Today;
            <div class="col-md-6 col-xl-4">
                <article class="card h-100"><div class="card-body d-flex flex-column">
                    @* Icon and the Active / Ended badge *@
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <span class="ht-stat-icon" aria-hidden="true"><i class="bi bi-egg-fried"></i></span>
                        <span class="badge rounded-pill @(ended ? "text-bg-secondary" : "text-bg-success")">@(ended ? "Ended" : "Active")</span>
                    </div>
                    <h2 class="h5">@plan.Title</h2>
                    @* The daily calorie target as a big number *@
                    <p class="mb-2"><span class="ht-stat-value fs-5">@plan.DailyCalorieTarget</span> <span class="text-muted small">kcal per day</span></p>
                    @* Description only when there is one *@
                    @if (!string.IsNullOrWhiteSpace(plan.Description))
                    {
                        <p class="text-muted small mb-2">@plan.Description</p>
                    }
                    <p class="small mb-3">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        @plan.StartDate.ToString("dd MMM yyyy") – @(plan.EndDate?.ToString("dd MMM yyyy") ?? "ongoing")
                    </p>
                    @* Opens ClientController.DietPlan, which checks the plan is theirs *@
                    <a asp-action="DietPlan" asp-route-id="@plan.Id" class="btn btn-sm btn-primary mt-auto align-self-start">Open plan</a>
                </div></article>
            </div>
        }
    </div>
}
<a asp-action="Index" class="btn btn-secondary mt-4">Dashboard</a>
