@model IReadOnlyList<HealthTrack.ViewModels.AssignedClientSummary>
@{ ViewData["Title"] = "My Clients"; }

@* Only clients actively assigned to this trainer are loaded by TrainerController.Clients. *@
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="ht-eyebrow">Trainer</span>
        <h1 class="mb-1">My Clients</h1>
        <p class="text-muted mb-0">Everyone assigned to you, with their latest progress.</p>
    </div>
    <a asp-controller="Progress" asp-action="Reports" class="btn btn-outline-primary"><i class="bi bi-bar-chart"></i> Performance Report</a>
</div>

@if (Model.Count == 0)
{
    <div class="card"><div class="card-body">
        <div class="ht-empty"><i class="bi bi-people" aria-hidden="true"></i>No clients are assigned to you yet. The administrator assigns clients to trainers.</div>
    </div></div>
}
else
{
    <div class="row g-4">
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="card h-100"><div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @* Initials in a circle instead of a photo *@
                        <span class="ht-stat-icon fw-bold" aria-hidden="true">@string.Concat(c.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]))</span>
                        <h2 class="h5 mb-0">@c.Name</h2>
                    </div>
                    <dl class="row mb-3 small">
                        <dt class="col-6 text-muted fw-normal">Latest weight</dt>
                        <dd class="col-6 text-end mb-1">@(c.LatestWeightKg is null ? "—" : $"{c.LatestWeightKg:0.0} kg")</dd>
                        <dt class="col-6 text-muted fw-normal">Latest BMI</dt>
                        <dd class="col-6 text-end mb-1">@(c.LatestBmi?.ToString("0.0") ?? "—")</dd>
                        <dt class="col-6 text-muted fw-normal">Workouts logged</dt>
                        <dd class="col-6 text-end mb-0">@c.WorkoutCount</dd>
                    </dl>
                    <div class="d-flex flex-wrap gap-2 mt-auto">
                        <a asp-action="ClientDetails" asp-route-id="@c.ClientId" class="btn btn-sm btn-primary">View Progress</a>
                        <a asp-action="GiveFeedback" asp-route-id="@c.ClientId" class="btn btn-sm btn-outline-primary">Give Feedback</a>
                        <a asp-controller="Progress" asp-action="Reports" asp-route-id="@c.ClientId" class="btn btn-sm btn-outline-secondary">Report</a>
                    </div>
                </div></article>
            </div>
        }
    </div>
}
