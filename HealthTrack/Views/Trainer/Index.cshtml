@model HealthTrack.ViewModels.TrainerDashboardViewModel
@{ ViewData["Title"] = "Trainer Dashboard"; }
<h1>Welcome, @Model.Name</h1>
<p class="text-muted">Your assigned clients and their progress.</p>
<nav class="d-flex flex-wrap gap-2 mb-4">
    <a asp-controller="WorkoutPlans" asp-action="Index" class="btn btn-primary">Workout Plans</a>
    <a asp-controller="DietPlans" asp-action="Index" class="btn btn-outline-primary">Diet Plans</a>
    <a asp-controller="Progress" asp-action="TrainerReport" class="btn btn-outline-secondary">Performance Report</a>
</nav>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h6">Active Clients</h2><p class="display-6">@Model.Clients.Count</p></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h6">Workout Plans</h2><p class="display-6">@Model.WorkoutPlanCount</p></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h6">Diet Plans</h2><p class="display-6">@Model.DietPlanCount</p></div></div></div>
</div>
<h2 class="h4">Assigned Clients</h2>
@if (Model.Clients.Count == 0) { <div class="alert alert-info">No clients are assigned to you yet. The administrator must assign them first.</div> }
else {
<div class="table-responsive"><table class="table table-striped align-middle">
    <thead><tr><th>Client</th><th>Latest Weight</th><th>Latest BMI</th><th>Workouts Logged</th><th></th></tr></thead>
    <tbody>@foreach (var c in Model.Clients) {
        <tr><td>@c.Name</td><td>@(c.LatestWeightKg?.ToString("0.0") ?? "—") kg</td>
        <td>@(c.LatestBmi?.ToString("0.0") ?? "—")</td><td>@c.WorkoutCount</td>
        <td><a asp-action="ClientDetails" asp-route-id="@c.ClientId" class="btn btn-sm btn-outline-primary">View Progress</a></td></tr>
    }</tbody>
</table></div>
}
<h2 class="h4 mt-4">Upcoming Appointments</h2>
@if (Model.UpcomingAppointments.Count == 0) { <p class="text-muted">No upcoming appointments.</p> }
else { <ul class="list-group">@foreach (var a in Model.UpcomingAppointments) {
<li class="list-group-item">@a.AppointmentDate.ToString("dd MMM yyyy HH:mm") — @a.Status</li>
}</ul> }
