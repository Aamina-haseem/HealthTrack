@* =====================================================================
   FILE:    Views/Trainer/GiveFeedback.cshtml
   PURPOSE: The trainer's "Give Feedback" page (TrainerController.GiveFeedback).
            A message and an optional 1-5 rating for one assigned client.
   ===================================================================== *@
@model HealthTrack.ViewModels.FeedbackCreateViewModel
@{ ViewData["Title"] = "Give Feedback"; }
@* Two-part card: orange info panel on the left, the form on the right (site.css section 10) *@
<div class="ht-form-page">
    @* Orange info panel: page title, a short intro and tips that state the real validation rules *@
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Client Feedback</span>
        <h1>Give Feedback</h1>
        <p>Your client sees this message on their dashboard.</p>
        @* Which plan / client this form is about *@
        <p class="ht-form-context"><i class="bi bi-person" aria-hidden="true"></i> Feedback for @ViewBag.ClientName</p>
        @* Tips, each with an icon (icons are decorative, so hidden from screen readers) *@
        <ul class="ht-form-tips">
            <li><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i><span>Start with what went well, then give one clear next step.</span></li>
            <li><i class="bi bi-star" aria-hidden="true"></i><span>The progress rating is optional, from 1 to 5.</span></li>
            <li><i class="bi bi-chat-left-text" aria-hidden="true"></i><span>Messages can be up to 1,000 characters.</span></li>
        </ul>
    </aside>
    @* The form itself *@
    <div class="ht-form-body">
        @* Posts to GiveFeedback; the form tag helper adds the anti-forgery token automatically. The id in the URL is checked again on the server. *@
        <form asp-action="GiveFeedback" asp-route-id="@ViewBag.ClientId" method="post">
            @* Errors that are not about one field, e.g. "could not be saved" *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @* Feedback message (up to 1,000 characters) *@
            <div class="mb-3"><label asp-for="Message" class="form-label"></label>
                <div class="ht-input"><i class="bi bi-chat-left-text" aria-hidden="true"></i>
                    <textarea asp-for="Message" rows="6" class="form-control"></textarea></div>
                <span asp-validation-for="Message" class="text-danger"></span></div>
            @* Optional progress rating from 1 to 5 *@
            <div class="mb-3"><label asp-for="Rating" class="form-label"></label>
                <div class="ht-input"><i class="bi bi-star" aria-hidden="true"></i>
                    <input asp-for="Rating" class="form-control" min="1" max="5" /></div>
                <span asp-validation-for="Rating" class="text-danger"></span></div>
            @* Buttons: save (arrow button) and cancel (back without saving) *@
            <div class="ht-form-actions">
                <button type="submit" class="btn btn-primary ht-btn-arrow">Send Feedback <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="ClientDetails" asp-route-id="@ViewBag.ClientId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@* Browser-side validation using the same rules as the view model (the server checks again) *@
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
