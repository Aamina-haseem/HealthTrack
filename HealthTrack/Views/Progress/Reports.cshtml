@* =====================================================================
   FILE:    Views/Progress/Reports.cshtml
   PURPOSE: The trainer's "Client Performance Report" (Task 7, ProgressController.Reports):
            workout minutes, calories burned and popular activities charts plus a
            table of every figure. ?id= limits it to one client. Printable.
   ===================================================================== *@
@model HealthTrack.ViewModels.TrainerReportViewModel
@{
    ViewData["Title"] = "Client Performance Report";

    // ProgressController.Reports only includes clients actively assigned to this trainer,
    // so the charts below cannot show anyone else's data.
    var activityChart = Model.PopularActivities
        .Select(a => new { activity = a.Activity, sessions = a.Sessions }).ToList();
    @* Name, minutes and calories for each client *@
    var minutesChart = Model.Clients
        .Select(c => new { name = c.Name, minutes = c.WorkoutMinutes, calories = c.CaloriesBurned }).ToList();
}

@* Short banner, the same style as the dashboards *@
<section class="ht-hero ht-hero-compact">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <span class="ht-eyebrow">Reports</span>
            <h1>Client Performance Report</h1>
            <p class="text-muted mb-0">
                @* When the report is for one client (?id=), say so *@
                @if (Model.FilteredClientName is not null) { <text>Showing <strong>@Model.FilteredClientName</strong> only. </text> }
                Only active clients currently assigned to you are included.
            </p>
        </div>
        @* d-print-none: these buttons are hidden on the printed page *@
        <nav class="d-flex flex-wrap gap-2 d-print-none" aria-label="Report actions">
            <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print Report</button>
            <a asp-controller="Trainer" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-speedometer2"></i> Dashboard</a>
        </nav>
    </div>
</section>

@* Empty state when there is nothing to report *@
@if (Model.Clients.Count == 0)
{
    <div class="card"><div class="card-body"><div class="ht-empty"><i class="bi bi-people" aria-hidden="true"></i>No assigned client activity to report.</div></div></div>
}
else
{
    @* ===== Charts: one measure per chart, so every bar uses the same scale ===== *@
    <div class="row g-4 mb-4">
        <section class="col-xl-4"><div class="card ht-chart-card h-100"><div class="card-body">
            <h2 class="ht-card-title">Workout Minutes</h2>
            <p class="ht-chart-sub">Total minutes logged per client.</p>
            @* Ranked bars (HT.ranked) *@
            <div class="ht-chart ht-chart-sm"><canvas id="minutesChart" role="img" aria-label="Bar chart of total workout minutes for each client"></canvas></div>
        </div></div></section>

        <section class="col-xl-4"><div class="card ht-chart-card h-100"><div class="card-body">
            <h2 class="ht-card-title">Calories Burned</h2>
            <p class="ht-chart-sub">Total kcal burned per client.</p>
            <div class="ht-chart ht-chart-sm"><canvas id="caloriesChart" role="img" aria-label="Bar chart of total calories burned for each client"></canvas></div>
        </div></div></section>

        <section class="col-xl-4"><div class="card ht-chart-card h-100"><div class="card-body">
            <h2 class="ht-card-title">Popular Activities</h2>
            <p class="ht-chart-sub">Most logged workouts across your clients.</p>
            @if (Model.PopularActivities.Count == 0)
            {
                <div class="ht-empty"><i class="bi bi-activity" aria-hidden="true"></i>No workouts logged yet.</div>
            }
            else
            {
                <div class="ht-chart ht-chart-sm"><canvas id="activityChart" role="img" aria-label="Bar chart of the most logged workout activities"></canvas></div>
            }
        </div></div></section>
    </div>

    @* ===== Full table ===== *@
    <section class="card mb-4"><div class="card-body">
        <h2 class="ht-card-title">All Figures</h2>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead><tr><th scope="col">Client</th><th scope="col">Workout Plans</th><th scope="col">Diet Plans</th>
                <th scope="col">Workouts</th><th scope="col">Meals</th><th scope="col">Minutes</th><th scope="col">kcal Burned</th>
                <th scope="col">Latest Weight</th><th scope="col">Latest BMI</th><th scope="col">Last Activity</th></tr></thead>
            @* One row per client; the name links to their progress page *@
            <tbody>@foreach (var x in Model.Clients) {
                <tr><td class="fw-semibold"><a asp-controller="Trainer" asp-action="ClientDetails" asp-route-id="@x.ClientId">@x.Name</a></td>
                    <td>@x.WorkoutPlanCount</td><td>@x.DietPlanCount</td><td>@x.WorkoutCount</td>
                    <td>@x.MealCount</td><td>@x.WorkoutMinutes</td><td>@x.CaloriesBurned</td>
                    <td>@(x.LatestWeightKg?.ToString("0.0") ?? "—")</td>
                    <td>@(x.LatestBmi?.ToString("0.0") ?? "—")</td>
                    <td>@(x.LastActivity?.ToString("dd MMM yyyy") ?? "Never")</td></tr>
            }</tbody>
        </table></div>
    </div></section>
}

@* Chart scripts *@
@section Scripts {
<script>
    // Json.Serialize safely encodes client names and activity names typed by users.
    // The drawing is done by the shared HT helpers in site.js.
    const minutesData = @Json.Serialize(minutesChart);
    const activityData = @Json.Serialize(activityChart);

    HT.ranked('minutesChart', minutesData.map(c => c.name), minutesData.map(c => c.minutes), 'Minutes');
    HT.ranked('caloriesChart', minutesData.map(c => c.name), minutesData.map(c => c.calories), 'kcal burned');
    HT.ranked('activityChart', activityData.map(a => a.activity), activityData.map(a => a.sessions), 'Sessions');
</script>
}
