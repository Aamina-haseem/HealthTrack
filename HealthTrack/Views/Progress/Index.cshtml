@model HealthTrack.ViewModels.ProgressDashboardViewModel
@{
    ViewData["Title"] = "My Progress";

    // All chart data below comes from Model, which ProgressController filled
    // with this signed-in client's own records only.
    var weightPoints = Model.Measurements.Select(m => new
    {
        date = m.Date.ToString("dd MMM yyyy"),
        weight = Math.Round(m.WeightKg, 1),
        bmi = Math.Round(m.BMI, 1)
    }).ToList();

    // Daily calories for the last 7 days (today included).
    var days = Enumerable.Range(0, 7).Select(i => DateTime.Today.AddDays(i - 6)).ToList();
    var calorieData = new
    {
        labels = days.Select(d => d.ToString("ddd dd MMM")).ToList(),
        burned = days.Select(d => Model.Workouts.Where(w => w.Date.Date == d).Sum(w => w.CaloriesBurned)).ToList(),
        eaten = days.Select(d => Model.Meals.Where(m => m.Date.Date == d).Sum(m => m.Calories)).ToList()
    };
    var hasRecentCalories = calorieData.burned.Any(x => x > 0) || calorieData.eaten.Any(x => x > 0);
}
<h1>My Progress</h1>
<p class="text-muted">Based on your own recorded workouts, meals and measurements.</p>
<p><a asp-controller="Logs" asp-action="Index" class="btn btn-primary">Add or Edit Logs</a>
   <a asp-controller="Client" asp-action="Index" class="btn btn-secondary">Dashboard</a></p>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><h2 class="h6">Weight Change</h2><p class="fs-3">@(Model.WeightChangeKg?.ToString("+0.0;-0.0;0.0") ?? "—") kg</p></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><h2 class="h6">Workout Minutes (30 days)</h2><p class="fs-3">@Model.WorkoutMinutesLast30Days</p></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><h2 class="h6">Calories Burned (30 days)</h2><p class="fs-3">@Model.CaloriesBurnedLast30Days</p></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><h2 class="h6">Calories Logged in Meals (30 days)</h2><p class="fs-3">@Model.CaloriesConsumedLast30Days</p></div></div></div>
</div>

<h2 class="h4">Weight and BMI Trend</h2>
@if (Model.Measurements.Count == 0)
{
    <div class="alert alert-info">Record a health measurement to see your trend.</div>
}
else
{
    @if (Model.Measurements.Count == 1)
    {
        <p class="text-muted">Only one measurement so far. Add another to see a trend line.</p>
    }
    <div class="card mb-3"><div class="card-body">
        <canvas id="weightChart" height="110" role="img"
                aria-label="Line chart of your weight in kilograms and BMI over time"></canvas>
    </div></div>
    <div class="table-responsive"><table class="table table-sm">
        <thead><tr><th>Date</th><th>Weight</th><th>BMI</th><th>Resting Heart Rate</th></tr></thead>
        <tbody>@foreach (var m in Model.Measurements.OrderByDescending(x => x.Date).Take(10)) {
            <tr><td>@m.Date.ToString("dd MMM yyyy")</td><td>@m.WeightKg.ToString("0.0") kg</td><td>@m.BMI.ToString("0.0")</td>
                <td>@(m.RestingHeartRate?.ToString() ?? "—")</td></tr>
        }</tbody>
    </table></div>
}

<h2 class="h4 mt-4">Calories: Last 7 Days</h2>
@if (!hasRecentCalories)
{
    <div class="alert alert-info">No workouts or meals logged in the last 7 days.</div>
}
else
{
    <div class="card mb-3"><div class="card-body">
        <canvas id="calorieChart" height="110" role="img"
                aria-label="Bar chart of calories burned in workouts and calories eaten in meals for each of the last 7 days"></canvas>
    </div></div>
}

<h2 class="h4 mt-4">Workout History</h2>
@if (Model.Workouts.Count == 0) { <p class="text-muted">No workouts logged.</p> }
else { <div class="table-responsive"><table class="table table-sm table-striped">
    <thead><tr><th>Date</th><th>Workout</th><th>Minutes</th><th>Calories Burned</th></tr></thead>
    <tbody>@foreach (var x in Model.Workouts.OrderByDescending(x => x.Date).Take(10)) {
        <tr><td>@x.Date.ToString("dd MMM yyyy")</td><td>@x.ExerciseName</td>
            <td>@x.DurationMinutes</td><td>@x.CaloriesBurned</td></tr>
    }</tbody>
</table></div> }

@section Scripts {
<script>
    // Json.Serialize encodes the data safely, so text typed by users
    // cannot break out of this script. Chart.js is loaded once in _Layout.
    const weightPoints = @Json.Serialize(weightPoints);
    const calories = @Json.Serialize(calorieData);

    const weightCanvas = document.getElementById('weightChart');
    if (weightCanvas && weightPoints.length > 0) {
        new Chart(weightCanvas, {
            type: 'line',
            data: {
                labels: weightPoints.map(p => p.date),
                datasets: [
                    { label: 'Weight (kg)', data: weightPoints.map(p => p.weight), yAxisID: 'y', pointRadius: 4, tension: 0.2 },
                    { label: 'BMI', data: weightPoints.map(p => p.bmi), yAxisID: 'y1', pointRadius: 4, tension: 0.2 }
                ]
            },
            options: {
                responsive: true,
                scales: {
                    y: { title: { display: true, text: 'Weight (kg)' } },
                    y1: { position: 'right', title: { display: true, text: 'BMI' }, grid: { drawOnChartArea: false } }
                }
            }
        });
    }

    const calorieCanvas = document.getElementById('calorieChart');
    if (calorieCanvas) {
        new Chart(calorieCanvas, {
            type: 'bar',
            data: {
                labels: calories.labels,
                datasets: [
                    { label: 'Burned in workouts (kcal)', data: calories.burned },
                    { label: 'Eaten in meals (kcal)', data: calories.eaten }
                ]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true, title: { display: true, text: 'Calories (kcal)' } } }
            }
        });
    }
</script>
}
