@* =====================================================================
   FILE:    Views/Admin/CreateTrainer.cshtml
   PURPOSE: The admin's "Add Trainer" page (AdminController.CreateTrainer).
            Creates a trainer account with a temporary password (checked by the password policy).
   ===================================================================== *@
@model HealthTrack.ViewModels.CreateTrainerViewModel
@{
    ViewData["Title"] = "Add Trainer";
}

@* Two-part card: orange info panel on the left, the form on the right (site.css section 10) *@
<div class="ht-form-page">
    @* Orange info panel: page title and tips *@
    <aside class="ht-form-info">
        <span class="ht-eyebrow">Administrator</span>
        <h1>Add a Trainer / Health Professional</h1>
        <p>Trainer accounts can only be created by the administrator. Give the trainer the temporary password; they can change it under their profile.</p>
        @* Tips, each with an icon (icons are decorative, so hidden from screen readers) *@
        <ul class="ht-form-tips">
            <li><i class="bi bi-envelope" aria-hidden="true"></i><span>The trainer signs in with this email address.</span></li>
            <li><i class="bi bi-shield-lock" aria-hidden="true"></i><span>Accounts lock for a while after 5 wrong passwords.</span></li>
            <li><i class="bi bi-diagram-3" aria-hidden="true"></i><span>Assign clients to the new trainer from Trainer Assignments.</span></li>
        </ul>
    </aside>

    @* The form itself *@
    <div class="ht-form-body">
        @* Posts to CreateTrainer; the form tag helper adds the anti-forgery token automatically. *@
        <form asp-action="CreateTrainer" method="post">
            @* Errors that are not about one field, e.g. "could not be saved" *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            @* A group of related fields with a small heading (legend) *@
            <fieldset class="ht-form-group">
                <legend>Trainer details</legend>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @* First name (letters only) *@
                        <label asp-for="FirstName" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-person" aria-hidden="true"></i>
                            <input asp-for="FirstName" class="form-control" />
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        @* Last name (letters only) *@
                        <label asp-for="LastName" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-person" aria-hidden="true"></i>
                            <input asp-for="LastName" class="form-control" />
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    @* Email address the trainer will sign in with *@
                    <label asp-for="Email" class="form-label"></label>
                    <div class="ht-input">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <input asp-for="Email" class="form-control" placeholder="trainer@healthtrack.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @* Specialization drop-down (the allowed list is in AdminController) *@
                        <label asp-for="Specialization" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-award" aria-hidden="true"></i>
                            <select asp-for="Specialization" asp-items="ViewBag.Specializations" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Specialization" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        @* Optional gender *@
                        <label asp-for="Gender" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-gender-ambiguous" aria-hidden="true"></i>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Optional --</option>
                                <option>Female</option>
                                <option>Male</option>
                                <option>Other</option>
                            </select>
                        </div>
                    </div>
                </div>
            </fieldset>

            @* A group of related fields with a small heading (legend) *@
            <fieldset class="ht-form-group">
                <legend>Temporary password</legend>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @* Temporary password (never shown again after saving) *@
                        <label asp-for="Password" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        @* Must match the password above *@
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <div class="ht-input">
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
                <p class="form-text mt-0"><i class="bi bi-shield-lock" aria-hidden="true"></i> At least 8 characters with an uppercase letter, a lowercase letter, a number and a symbol.</p>
            </fieldset>

            @* Buttons: save (arrow button) and cancel (back without saving) *@
            <div class="ht-form-actions">
                <button type="submit" class="btn btn-primary ht-btn-arrow">Create Trainer Account <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@* Browser-side validation using the same rules as the view model (the server checks again) *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
