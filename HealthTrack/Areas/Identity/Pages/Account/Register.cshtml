@page
@model RegisterModel
@* =====================================================================
   FILE:    Areas/Identity/Pages/Account/Register.cshtml
   PURPOSE: The Register page's markup (the logic is in Register.cshtml.cs): a
            two-column form (name, date of birth, gender, email, password) beside
            a photo panel. New accounts always become Clients, and the age must
            be 13-100 (checked on the server).
   ===================================================================== *@
@* Page title *@
@{
    ViewData["Title"] = "Register";
}

@* A wide two-column form beside a slim photo panel, so the whole page fits on screen without scrolling.
   The "Use another service" section was removed because HealthTrack only uses local accounts (Individual Accounts).
   Profile fields (name, date of birth, gender) were added for the Client profile. *@
<section class="ht-auth ht-auth-split ht-auth-register" aria-labelledby="register-title">
    <div class="ht-auth-card">
        <a class="ht-auth-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-heart-pulse-fill" aria-hidden="true"></i> HealthTrack
        </a>
        <h1 id="register-title">Create account</h1>
        <p class="ht-auth-sub">Start tracking your workouts, meals and progress.</p>

        @* Posts to RegisterModel.OnPostAsync; the anti-forgery token is added automatically *@
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            @* Errors not tied to one field, e.g. "Email is already taken" *@
            <div asp-validation-summary="ModelOnly" class="mb-3" role="alert"></div>

            @* Two columns on tablets and up (col-sm-6), one column on phones *@
            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="Input.FirstName" class="form-label">First name</label>
                    <div class="ht-input">
                        <i class="bi bi-person" aria-hidden="true"></i>
                        @* autocomplete lets the browser fill in the name *@
                        <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" aria-required="true" placeholder="First name" />
                    </div>
                    @* Error message for this field (from the InputModel attributes) *@
                    <span asp-validation-for="Input.FirstName"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Input.LastName" class="form-label">Last name</label>
                    <div class="ht-input">
                        <i class="bi bi-person" aria-hidden="true"></i>
                        <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" aria-required="true" placeholder="Last name" />
                    </div>
                    <span asp-validation-for="Input.LastName"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.DateOfBirth" class="form-label">Date of birth</label>
                    <div class="ht-input">
                        <i class="bi bi-calendar-event" aria-hidden="true"></i>
                        @* Date picker; max = today, so a future date cannot be picked (the 13-100 rule is checked on the server) *@
                        <input asp-for="Input.DateOfBirth" type="date" class="form-control" aria-required="true"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <span asp-validation-for="Input.DateOfBirth"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Input.Gender" class="form-label">Gender</label>
                    <div class="ht-input">
                        <i class="bi bi-gender-ambiguous" aria-hidden="true"></i>
                        @* The empty first option forces a real choice ([Required]) *@
                        <select asp-for="Input.Gender" class="form-select" aria-required="true">
                            <option value="">-- Select --</option>
                            <option>Female</option>
                            <option>Male</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <span asp-validation-for="Input.Gender"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <div class="ht-input">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        @* The email is also the username *@
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Input.Email"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <div class="ht-input">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        @* autocomplete="new-password" lets password managers suggest a strong password *@
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                    </div>
                    <span asp-validation-for="Input.Password"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                    <div class="ht-input">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        @* Must match Password ([Compare] in the InputModel) *@
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Type it again" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword"></span>
                </div>
            </div>

            @* The password rules (set in Program.cs) shown before the user types *@
            <p class="ht-auth-hint"><i class="bi bi-shield-lock" aria-hidden="true"></i> 8+ characters with an uppercase letter, a lowercase letter, a number and a symbol.</p>

            @* Submit button *@
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary ht-btn-arrow justify-content-center">Create account <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
        </form>

        <p class="ht-auth-footer mb-0">
            Already have an account?
            @* Link to Login, keeping the return URL *@
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
        </p>
    </div>

    @* Photo: wwwroot/images/auth.jpg (Sushil Ghimire, Unsplash), set in site.css *@
    <div class="ht-auth-photo">
        <span class="ht-eyebrow">Join HealthTrack</span>
        <p class="ht-auth-quote">Start your journey today.</p>
        <ul class="ht-auth-points">
            <li><i class="bi bi-check2-circle" aria-hidden="true"></i> Plans made by a trainer</li>
            <li><i class="bi bi-check2-circle" aria-hidden="true"></i> Book sessions with your trainer</li>
            <li><i class="bi bi-check2-circle" aria-hidden="true"></i> Weight, BMI and calorie charts</li>
        </ul>
    </div>
</section>

@* Browser-side validation using the same rules as the server *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
